# ═══════════════════════════════════════════════════════════
# CigarOdyssey — fichiers à ne jamais versionner
# ═══════════════════════════════════════════════════════════

# Secrets — variables d'environnement (utiliser .env.example comme modèle)
.env
# Sauvegardes locales de config (accès prod)
*.bak
backend/config.php.prod.bak

# Logs serveur
backend/error_log
*.log

# Cache généré
backend/cache/*
!backend/cache/.gitkeep

# Contenu uploadé par les utilisateurs (à sauvegarder séparément, pas dans Git)
uploads/*
!uploads/.gitkeep
# EXCEPTION : le .htaccess interdit l'exécution dans ce dossier. Ignoré,
# il ne partirait jamais en ligne — la protection n'existerait que sur
# le poste de développement, là où elle ne sert à rien.
!uploads/.htaccess
# Le second .htaccess, celui du sous-dossier, était dans ce cas exact :
# corrigé sur ce poste, jamais suivi, donc absent de toute mise en ligne.
#
# Une exception ne suffit PAS à le rattraper. `uploads/*` exclut le
# dossier `lounges` lui-même, et Git ne descend pas dans un dossier
# exclu : `!uploads/lounges/.htaccess` seul ne serait jamais consulté.
# Il faut d'abord réadmettre le dossier, puis en réexclure le contenu,
# puis rouvrir le seul fichier voulu.
!uploads/lounges/
uploads/lounges/*
!uploads/lounges/.htaccess

# OS / éditeurs
.DS_Store
Thumbs.db
.vscode/
.idea/
# Réglages locaux de l'outil d'assistance (adresse du serveur de
# développement, arbres de travail). Même statut que .vscode/ : c'est
# le poste, pas le projet.
.claude/

# Archives
*.rar
*.zip

# Outillage de test de bout en bout (Playwright). Rien de tout ceci
# n'est deploye : le site reste sans etape de build.
# package-lock.json est versionne : l'integration continue doit
# installer exactement la meme version de Playwright.
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# Copie locale des ressources tierces (polices Google, Leaflet) que la
# campagne sert depuis le disque au lieu d'interroger le reseau a chaque
# chargement. Reconstruite toute seule. Voir tests/e2e/statique.js.
/tests/e2e/.cache-tiers/

# Maquettes de comparaison WebGL (locales, non integrees a l'application).
# Conservees pour reference, volontairement hors depot : elles embarquent
# Three.js (~600 Ko) et ne servent qu'a arbitrer le chantier D6.
docs/demo/
