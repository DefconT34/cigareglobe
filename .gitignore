# ═══════════════════════════════════════════════════════════
# CigarGlobe — fichiers à ne jamais versionner
# ═══════════════════════════════════════════════════════════

# Secrets — variables d'environnement (utiliser .env.example comme modèle)
.env
# Sauvegardes locales de config (accès prod)
*.bak
backend/config.php.prod.bak

# Logs serveur
backend/error_log
*.log

# Cache généré
backend/cache/*
!backend/cache/.gitkeep

# Contenu uploadé par les utilisateurs (à sauvegarder séparément, pas dans Git)
uploads/*
!uploads/.gitkeep

# OS / éditeurs
.DS_Store
Thumbs.db
.vscode/
.idea/

# Archives
*.rar
*.zip

# Outillage de test de bout en bout (Playwright). Rien de tout ceci
# n'est deploye : le site reste sans etape de build.
# package-lock.json est versionne : l'integration continue doit
# installer exactement la meme version de Playwright.
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Maquettes de comparaison WebGL (locales, non integrees a l'application).
# Conservees pour reference, volontairement hors depot : elles embarquent
# Three.js (~600 Ko) et ne servent qu'a arbitrer le chantier D6.
docs/demo/
