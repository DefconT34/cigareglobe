# ── Sécurité : config.php inaccessible directement ───────
<Files "config.php">
    Require all denied
</Files>

# ── PHP 8.0 (OVH/cPanel) ─────────────────────────────────
# Décommentez la ligne correspondant à votre hébergeur :
# AddHandler application/x-httpd-php80 .php   # OVH
# AddHandler application/x-httpd-php81 .php   # Infomaniak

# ── CORS géré par l'API, pas besoin ici ──────────────────

# ── Protection répertoire ─────────────────────────────────
Options -Indexes
