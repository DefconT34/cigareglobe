# CigarOdyssey — Performance & Sécurité
# o2switch / Apache 2.4

# ── Compression Gzip/Deflate ──────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ── Brotli (si disponible) ────────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
</IfModule>

# ── Cache navigateur ──────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 1 hour"
  ExpiresByType text/css               "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/json       "access plus 5 minutes"
  ExpiresByType image/svg+xml          "access plus 1 month"
  ExpiresByType image/jpeg             "access plus 1 month"
  ExpiresByType image/png              "access plus 1 month"
  ExpiresByType image/webp             "access plus 1 month"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# ── Headers sécurité ──────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options  "nosniff"
  Header always set X-Frame-Options         "SAMEORIGIN"
  Header always set Referrer-Policy         "strict-origin-when-cross-origin"
  Header always set Permissions-Policy      "geolocation=(self), camera=(), microphone=(), payment=()"

  # ── HSTS ───────────────────────────────────────────────
  # La redirection plus bas envoie http vers https. Elle ne protege pas
  # la PREMIERE visite : la requete en clair part avant de savoir qu il
  # fallait chiffrer, et c est celle-la qu on intercepte. Cet en-tete
  # dit au navigateur de ne plus jamais essayer en clair.
  #
  # Emis uniquement sur une reponse deja chiffree. Un navigateur
  # l ignore de toute facon en clair, mais l emettre laisserait croire
  # a une protection qui n existe pas.
  #
  # CE QU IL ENGAGE, ET QUI NE SE REPREND PAS. Pendant un an, ce
  # domaine ne repondra plus en clair pour quiconque l a visite une
  # fois. Un certificat expire devient un site inaccessible, sans
  # contournement possible par le visiteur. C est le but. C est aussi
  # pourquoi les deux options qu on ajoute d ordinaire par reflexe sont
  # ABSENTES ici :
  #
  #   includeSubDomains  engage tous les sous-domaines, y compris ceux
  #                      qui n existent pas encore. A n ajouter qu apres
  #                      avoir verifie qu aucun ne repond en clair.
  #   preload            inscrit le domaine dans les navigateurs
  #                      eux-memes ; le retrait prend des mois. Jamais
  #                      « pour voir ».
  #
  # POURQUOI « <If> » ET NON « env=HTTPS ». Les deux formes marchent,
  # mais la seconde ne s eprouve pas : `SetEnvIf` ne peut PAS definir
  # `HTTPS`, que mod_ssl se reserve. Une faute de frappe dans le nom de
  # la variable aurait donc donne, en local, exactement le meme silence
  # qu une directive correcte — et personne n aurait su avant la mise en
  # ligne. Ici, l expression se verifie : en inversant la condition, on
  # voit l en-tete apparaitre en clair. Fait, et l inverse retire.
  #
  # A REVERIFIER APRES LA MISE EN LIGNE, ou seul le vrai TLS repond :
  #   curl -sI https://thecigarodyssey.com | grep -i strict-transport
  <If "%{HTTPS} == 'on'">
    Header always set Strict-Transport-Security "max-age=31536000"
  </If>

  # NB : le CORS est géré par les endpoints PHP (cors_headers()). Ne pas
  # le forcer ici : un « Header set » écraserait leur logique et
  # renverrait « * » y compris sur les réponses authentifiées.

  # ── Content-Security-Policy ────────────────────────────
  # Limite les origines exécutables. 'unsafe-inline' reste nécessaire :
  # l'application utilise encore des scripts et styles en ligne
  # (service worker, interface d'administration). Le durcissement par
  # nonces suppose de les externaliser au préalable.
  # topojson, la carte du monde ET LEAFLET sont desormais servis
  # localement (assets/vendor, assets/data). `script-src` et `style-src`
  # n'autorisent donc plus aucune origine tierce : unpkg est sorti avec
  # l'auto-hebergement de Leaflet 1.9.4.
  #
  # Ce qui reste hors du site — verifie a l'ecran, requetes comptees par
  # origine sur une page complete : 44 vers le site, 16 tuiles, 6 polices.
  #   tile.openstreetmap : tuiles de la carte (couvert par img-src https:)
  #   fonts.googleapis   : polices du SITE, importees par assets/css/themes.css
  #                        (et non de la seule administration, comme le
  #                        disait ce commentaire depuis la migration A3)
  #   fonts.gstatic      : les fichiers de police que la feuille ci-dessus
  #                        appelle a son tour
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ── Blocage des fichiers cachés (.env, .htaccess…) ────────
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
# Bloquer aussi les sauvegardes de config
<FilesMatch "\.(bak|prod\.bak)$">
  Require all denied
</FilesMatch>

# ── Les DOSSIERS cachés — .git en premier ─────────────────
# `<FilesMatch "^\.">` ci-dessus ne couvre que les NOMS DE FICHIERS.
# Dans « /.git/config », le nom est « config » : la règle ne s'applique
# pas, et Apache servait le fichier. Mesuré, pas supposé :
#
#   /.git/config      200
#   /.git/HEAD        200
#   /.git/logs/HEAD   200
#
# Or `.git` contient l'historique complet — donc tout le code, et tout ce
# qui y a jamais figuré. Le trou ne s'ouvre qu'au moment où l'on déploie
# par `git clone` dans la racine web, ce qui est justement la méthode
# la plus commode.
#
# `.well-known` est EXEMPTÉ : Let's Encrypt y dépose sa preuve à chaque
# renouvellement. Bloquer ce chemin ferait expirer le certificat au bout
# de quatre-vingt-dix jours, sans que rien ne le signale d'ici là.
#
# POURQUOI mod_rewrite ET NON RedirectMatch. La première rédaction
# utilisait `RedirectMatch`, de mod_alias. Résultat mesuré : erreur 500
# sur TOUT le site, page d'accueil comprise — le module n'était pas
# chargé, et Apache rejette le fichier entier plutôt que la seule ligne
# fautive. mod_rewrite, lui, est déjà employé plus bas pour les URL par
# langue : il est donc chargé, et la règle s'éprouve au lieu de se
# supposer.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Les dossiers cachés, sauf .well-known.
  RewriteRule "(^|/)\.(?!well-known/)" - [R=404,L]

  # Ce qui sert au développement, pas aux visiteurs. Aucune page
  # n'appelle ces chemins. Servis, ils donnent le contenu entier de la
  # base en un fichier (`sql/contenu.sql`, 5 Mo), le schéma, les
  # migrations, et une documentation qui décrit la configuration.
  # `tests/` et `tools/` portent déjà leur propre .htaccess.
  RewriteRule "^(sql|docs)/" - [R=404,L]
</IfModule>

<FilesMatch "^(package(-lock)?\.json|composer\.(json|lock)|playwright\.config\.js)$">
  Require all denied
</FilesMatch>

# ── Réécriture ────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS d'abord — sauf en local, où il n'y a pas de certificat.
  #
  # Sans ces exceptions, un Apache de développement redirige vers
  # https://127.0.0.1:8080, port qui ne sert pas de TLS : le navigateur
  # reçoit une connexion fermée et le site paraît hors service. Les
  # adresses écartées ne peuvent pas désigner un serveur public —
  # boucle locale, plages privées RFC 1918, et le domaine .local.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.\d+\.\d+\.\d+(:\d+)?$
  RewriteCond %{HTTP_HOST} !^192\.168\.\d+\.\d+(:\d+)?$
  RewriteCond %{HTTP_HOST} !^10\.\d+\.\d+\.\d+(:\d+)?$
  RewriteCond %{HTTP_HOST} !^172\.(1[6-9]|2\d|3[01])\.\d+\.\d+(:\d+)?$
  RewriteCond %{HTTP_HOST} !\.local(:\d+)?$ [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Une URL par langue ──────────────────────────────────
  # Le français reste à la racine ; les cinq autres langues ont leur
  # préfixe. index.php sert index.html en adaptant lang, dir, titre,
  # description, canonique et hreflang — ce qu'un moteur de recherche
  # lit avant d'exécuter le JavaScript.
  #
  # Sans barre finale : on redirige, pour n'avoir qu'une seule URL
  # indexable par langue.
  RewriteRule ^(en|es|de|zh|ar)$ /$1/ [R=301,L]
  # E=PRETTY:1 : index.php sait ainsi que la reecriture fonctionne
  # reellement, et le front peut construire des liens /en/ plutot que
  # ?lang=en. Sans ce temoin, un serveur sans mod_rewrite (php -S en
  # developpement) verrait ses liens de langue mener nulle part.
  RewriteRule ^(en|es|de|zh|ar)/?$ /index.php?lang=$1 [L,QSA,E=PRETTY:1]

  # La racine passe aussi par index.php (français).
  RewriteRule ^$ /index.php?lang=fr [L,QSA,E=PRETTY:1]

  # ── Le contenu, servi par le serveur ────────────────────
  # Le plan de site n'annonçait que seize adresses : six pages d'accueil
  # et dix fils de discussion. Cinq cents établissements, cent dix-huit
  # maisons et cent huit pays n'existaient QUE dans le JavaScript — donc
  # pour personne d'autre que ceux qui connaissaient déjà le site.
  #
  # page.php sert une vraie page par entité, dans les six langues.
  # Le préfixe de langue est optionnel : /pays/cuba est le français,
  # /en/pays/cuba l'anglais. Un seul vocabulaire de segments, en
  # français, parce que le site a une langue d'origine — multiplier les
  # segments par langue aurait multiplié les règles sans rien apporter
  # au référencement, qui se joue sur le slug et le contenu.
  #
  # L'ordre compte : ces règles viennent APRÈS celles des pages
  # d'accueil, qui sont ancrées par ^…$ et ne peuvent pas les capter.
  RewriteRule ^(?:(en|es|de|zh|ar)/)?atlas/?$        /page.php?lang=$1&type=atlas [L,QSA,E=PRETTY:1]
  RewriteRule ^(?:(en|es|de|zh|ar)/)?pays/([a-z0-9-]{1,60})/?$   /page.php?lang=$1&type=pays&id=$2 [L,QSA,E=PRETTY:1]
  RewriteRule ^(?:(en|es|de|zh|ar)/)?marque/([a-z0-9-]{1,80})/?$ /page.php?lang=$1&type=marque&id=$2 [L,QSA,E=PRETTY:1]
  # L'identifiant numérique fait foi ; le slug qui le suit n'est là que
  # pour l'humain et pour le lien partagé. Un slug changé ne casse donc
  # aucune adresse déjà indexée.
  RewriteRule ^(?:(en|es|de|zh|ar)/)?cave/(\d{1,9})(?:-[a-z0-9-]*)?/?$ /page.php?lang=$1&type=cave&id=$2 [L,QSA,E=PRETTY:1]

  # Plan de site : genere, pour que le domaine suive SITE_URL.
  RewriteRule ^sitemap\.xml$ /sitemap.php [L]
</IfModule>

# index.php prime sur index.html : sans cela, Apache servirait le
# fichier statique et court-circuiterait tout le travail ci-dessus.
DirectoryIndex index.php index.html

# ── Page d'erreur personnalisée ───────────────────────────
ErrorDocument 404 /index.html
