# CigarOdyssey — Performance & Sécurité
# o2switch / Apache 2.4

# ── Compression Gzip/Deflate ──────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ── Brotli (si disponible) ────────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
</IfModule>

# ── Cache navigateur ──────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 1 hour"
  ExpiresByType text/css               "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/json       "access plus 5 minutes"
  ExpiresByType image/svg+xml          "access plus 1 month"
  ExpiresByType image/jpeg             "access plus 1 month"
  ExpiresByType image/png              "access plus 1 month"
  ExpiresByType image/webp             "access plus 1 month"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# ── Headers sécurité ──────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options  "nosniff"
  Header always set X-Frame-Options         "SAMEORIGIN"
  Header always set Referrer-Policy         "strict-origin-when-cross-origin"
  Header always set Permissions-Policy      "geolocation=(self), camera=(), microphone=(), payment=()"

  # NB : le CORS est géré par les endpoints PHP (cors_headers()). Ne pas
  # le forcer ici : un « Header set » écraserait leur logique et
  # renverrait « * » y compris sur les réponses authentifiées.

  # ── Content-Security-Policy ────────────────────────────
  # Limite les origines exécutables. 'unsafe-inline' reste nécessaire :
  # l'application utilise encore des scripts et styles en ligne
  # (service worker, interface d'administration). Le durcissement par
  # nonces suppose de les externaliser au préalable.
  # topojson, la carte du monde ET LEAFLET sont desormais servis
  # localement (assets/vendor, assets/data). `script-src` et `style-src`
  # n'autorisent donc plus aucune origine tierce : unpkg est sorti avec
  # l'auto-hebergement de Leaflet 1.9.4.
  #
  # Ce qui reste hors du site :
  #   tile.openstreetmap : tuiles de la carte (couvert par img-src https:)
  #   fonts.googleapis   : polices de l'administration
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ── Blocage des fichiers cachés (.env, .git, .htaccess…) ──
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
# Bloquer aussi les sauvegardes de config
<FilesMatch "\.(bak|prod\.bak)$">
  Require all denied
</FilesMatch>

# ── Réécriture ────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS d'abord — sauf en local, où il n'y a pas de certificat.
  #
  # Sans ces exceptions, un Apache de développement redirige vers
  # https://127.0.0.1:8080, port qui ne sert pas de TLS : le navigateur
  # reçoit une connexion fermée et le site paraît hors service. Les
  # adresses écartées ne peuvent pas désigner un serveur public —
  # boucle locale, plages privées RFC 1918, et le domaine .local.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.\d+\.\d+\.\d+(:\d+)?$
  RewriteCond %{HTTP_HOST} !^192\.168\.\d+\.\d+(:\d+)?$
  RewriteCond %{HTTP_HOST} !^10\.\d+\.\d+\.\d+(:\d+)?$
  RewriteCond %{HTTP_HOST} !^172\.(1[6-9]|2\d|3[01])\.\d+\.\d+(:\d+)?$
  RewriteCond %{HTTP_HOST} !\.local(:\d+)?$ [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Une URL par langue ──────────────────────────────────
  # Le français reste à la racine ; les cinq autres langues ont leur
  # préfixe. index.php sert index.html en adaptant lang, dir, titre,
  # description, canonique et hreflang — ce qu'un moteur de recherche
  # lit avant d'exécuter le JavaScript.
  #
  # Sans barre finale : on redirige, pour n'avoir qu'une seule URL
  # indexable par langue.
  RewriteRule ^(en|es|de|zh|ar)$ /$1/ [R=301,L]
  # E=PRETTY:1 : index.php sait ainsi que la reecriture fonctionne
  # reellement, et le front peut construire des liens /en/ plutot que
  # ?lang=en. Sans ce temoin, un serveur sans mod_rewrite (php -S en
  # developpement) verrait ses liens de langue mener nulle part.
  RewriteRule ^(en|es|de|zh|ar)/?$ /index.php?lang=$1 [L,QSA,E=PRETTY:1]

  # La racine passe aussi par index.php (français).
  RewriteRule ^$ /index.php?lang=fr [L,QSA,E=PRETTY:1]

  # Plan de site : genere, pour que le domaine suive SITE_URL.
  RewriteRule ^sitemap\.xml$ /sitemap.php [L]
</IfModule>

# index.php prime sur index.html : sans cela, Apache servirait le
# fichier statique et court-circuiterait tout le travail ci-dessus.
DirectoryIndex index.php index.html

# ── Page d'erreur personnalisée ───────────────────────────
ErrorDocument 404 /index.html
