# ═══════════════════════════════════════════════════════════
# CigarOdyssey — variables d'environnement (MODÈLE)
# Copier ce fichier vers .env et renseigner les valeurs.
# .env est ignoré par Git : ne jamais committer les secrets.
# ═══════════════════════════════════════════════════════════

# ── Base de données ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cigarodyssey
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── Administration ───────────────────────────────────────
# Générer une clé longue et aléatoire (ex: random.org/passwords)
ADMIN_KEY=CHANGEZ_MOI_CLE_ALEATOIRE
ADMIN_EMAIL=vous@example.com

# ── CORS ─────────────────────────────────────────────────
# Origines autorisées à lire l'API depuis un navigateur.
# EN PRODUCTION : le ou les domaines réels, séparés par des virgules.
# Le domaine nu et le sous-domaine www sont deux origines distinctes —
# déclarer les deux si les deux répondent.
# EN LOCAL : mettre * (le front et l'API sont servis ensemble).
ALLOWED_ORIGIN=https://cigarodyssey.com,https://www.cigarodyssey.com

# ── Site / emails ────────────────────────────────────────
# URL publique (sert aux liens des emails). En local: http://localhost:PORT
SITE_URL=https://cigarodyssey.com
MAIL_FROM=noreply@cigarodyssey.com
MAIL_FROM_NAME=CigarOdyssey
# Adresse de réponse réelle (facultatif). Laisser vide plutôt que de
# renvoyer vers noreply : un Reply-To mort dégrade la réputation.
MAIL_REPLY_TO=

# Transport. Voir docs/emails.md pour le choix et la configuration DNS.
#   log      n'envoie rien, journalise (développement)
#   mail     fonction mail() de PHP — repli, finit souvent en spam
#   brevo    API Brevo (recommandé : offre gratuite 300 emails/jour)
#   mailgun  API Mailgun
#   resend   API Resend
MAIL_DRIVER=mail
MAIL_API_KEY=
# Mailgun uniquement — domaine d'envoi et point d'entrée régional
MAILGUN_DOMAIN=
MAILGUN_HOST=api.mailgun.net
# Délai d'attente HTTP en secondes
MAIL_TIMEOUT=10

# DEV : true = n'envoie aucun email, les journalise dans
# backend/cache/mail_outbox.log (pour récupérer les liens de test)
MAIL_LOG_ONLY=false

# ── Seuils de vote communautaire ─────────────────────────
VOTES_TO_APPROVE=3
VOTES_TO_REJECT=3

# Contributions approuvées requises pour devenir « contributeur de confiance »
# (ses ajouts suivants sont publiés sans modération)
TRUSTED_AFTER_APPROVED=5

# Diagnostic : true = renvoie les messages d’erreur techniques au client.
# NE JAMAIS activer en production.
APP_DEBUG=false
